# Cynbit Scout - Environment Configuration Template
# Copy this file to .env and configure your keys if using LLM mode.

# Optional: Google Gemini API Key (leaves empty to default to Rules Fallback Mode)
GEMINI_API_KEY=

# Optional: OpenAI API Key (alternative provider)
OPENAI_API_KEY=

# Operational Settings
CYNBIT_SCOUT_ENV=development
DATABASE_PATH=data/cynbit_scout.db

# Processing Mode: 'hybrid' (LLM with rule fallback), 'llm_only', or 'rules_only'
DEFAULT_PROCESSING_MODE=hybrid

# LLM Timeout in seconds
LLM_TIMEOUT_SECONDS=8
